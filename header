    .ticks { transform-origin: 1072px 180px; animation: counter 3.2s cubic-bezier(.22,.8,.3,1) both; }
    .core-rune { animation: kindle 1.1s ease-out 2.6s both; }
    .marker { animation: kindle 0.6s ease-out 2.9s both; }
    @keyframes unlock {
      0%   { transform: rotate(-600deg); }
      78%  { transform: rotate(4deg); }
      90%  { transform: rotate(-1.5deg); }
      100% { transform: rotate(0deg); }
    }
    @keyframes counter {
      0%   { transform: rotate(320deg); }
      100% { transform: rotate(0deg); }
    }
    @keyframes kindle {
      0%   { opacity: .18; }
      100% { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .dial, .ticks, .core-rune, .marker { animation: none; }
    }
  </style>

